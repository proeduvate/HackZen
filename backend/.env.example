APP_NAME=Hackathon Portal AI Backend
APP_VERSION=1.0.0
DEBUG=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=1000
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_RETRY_BACKOFF_SECONDS=1.25

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=5

DATASETS_DIR=backend/data/datasets
MEMORY_DIR=backend/data/memory
LOGS_DIR=backend/logs
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
HISTORY_LIMIT=12

