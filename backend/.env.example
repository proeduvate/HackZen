# Public URLs used by the browser OAuth redirect flow
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000

# Create OAuth apps with Google, GitHub, and LinkedIn, then add their keys here.
# Register these exact callback URLs in each provider dashboard:
# http://127.0.0.1:8000/api/auth/oauth/google/callback
# http://127.0.0.1:8000/api/auth/oauth/github/callback
# http://127.0.0.1:8000/api/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
